APP_ENV=local
APP_NAME=CommServe Bank
APP_URL=http://localhost/commserve/public
# Path under which the app is served, e.g. /commserve/public. Leave empty when
# the web server document root already points at public/. Auto-detected when unset.
#BASE_PATH=/commserve/public
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=commserve
DB_USER=root
DB_PASS=
SESSION_SECURE=false
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en
# Development mail: log (view in Admin -> Dev Mailbox) | smtp (MailHog/Papercut) | mail (PHP mail())
MAIL_DRIVER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=no-reply@commserve.test
